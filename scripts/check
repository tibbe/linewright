}

# The bin directory of a Java 21 runtime.
java21() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/linewright/temurin-jre-$temurin_version" target sha
  local tree="jdk-$temurin_version-jre" home
  case "$(uname -s)" in
  Darwin) home="$dir/$tree/Contents/Home" ;;
  *) home="$dir/$tree" ;;
  esac
  if [ ! -x "$home/bin/java" ]; then
    case "$(uname -sm)" in
    "Darwin arm64") target=aarch64_mac sha=225bab0a09491ef06835488cd942f5d2befa9a0410a2484f0c8bbcf7506ec09a ;;
    "Darwin x86_64") target=x64_mac sha=c909674b1c10c261b9a3fb7e9c0efebd303e33f88a4fe84be7135b5e2d711f89 ;;
    "Linux aarch64" | "Linux arm64") target=aarch64_linux sha=b1734db7ade49c3f6acc6ae06233b8c2dd90e3e2f00f67000ae1c972aaa64d8c ;;
    "Linux x86_64") target=x64_linux sha=a535a1df9c6284d9618872984e026ae0352d1f7e9e0605425c0e6114f47351dd ;;
    *) no_release "Temurin $temurin_version" || return 1 ;;
    esac
    install_tree "$dir" "$tree" \
      "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${temurin_version/+/%2B}/OpenJDK21U-jre_${target}_hotspot_${temurin_version/+/_}.tar.gz" \
      "$sha" >&2 || return 1
  fi
  echo "$home/bin"
}

# Quint, from the model's lockfile, with Apalache and the Rust evaluator where
# Quint looks for them (QUINT_HOME), so that it fetches nothing itself.
quint() {
  local lock=docs/model/package-lock.json cache="${XDG_CACHE_HOME:-$HOME/.cache}/linewright"
  local dir home="$cache/quint-home" target sha bin tmp status
  dir="$cache/quint-$({ sha256sum "$lock" 2>/dev/null || shasum -a 256 "$lock"; } | cut -c1-16)"
  if [ ! -x "$dir/node_modules/.bin/quint" ]; then
    tmp="$(mktemp -d)"
    cp docs/model/package.json "$lock" "$tmp/"
    if (cd "$tmp" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error) &&
      mkdir -p "$cache" && { [ -e "$dir" ] || mv "$tmp" "$dir"; }; then
      rm -rf "$tmp"
    else
      rm -rf "$tmp"
      return 1
    fi
  fi
  if [ ! -e "$home/apalache-dist-$apalache_version/apalache/lib/apalache.jar" ]; then
    install_tree "$home/apalache-dist-$apalache_version" apalache \
      "https://github.com/apalache-mc/apalache/releases/download/v$apalache_version/apalache.tgz" \
      8ac8488422c30d552735bae11b92a2d014d8e02e8608702acc08f9a2d8a9abb2 || return 1
  fi
  if [ ! -x "$home/rust-evaluator-$quint_evaluator_version/quint_evaluator" ]; then
    case "$(uname -sm)" in
    "Darwin arm64") target=aarch64-apple-darwin sha=62a7b5226bbc73c738cce94a265b1f87d062e3d1b30a16f7210132f00d8b95b2 ;;
    "Darwin x86_64") target=x86_64-apple-darwin sha=b4c2a706cad360151d08b5ce1577e23859a47b4e16ad11e53dbe8de7e5c450ca ;;
    "Linux aarch64" | "Linux arm64") target=aarch64-unknown-linux-gnu sha=706819d56eb2153a12b7d3c07b5060917cf5f4431bf5069f998f9ff1e97c4388 ;;
    "Linux x86_64") target=x86_64-unknown-linux-gnu sha=ce0502bdef65dc26c242a9e56379a9bb26de6f3db38f0e3989339d46a542f5eb ;;
    *) no_release "Quint's evaluator $quint_evaluator_version" || return 1 ;;
    esac
    install_tool "$home/rust-evaluator-$quint_evaluator_version" quint_evaluator \
      "https://github.com/quint-co/quint/releases/download/evaluator/$quint_evaluator_version/quint_evaluator-$target.tar.gz" \
      "$sha" quint_evaluator || return 1
  fi
  bin="$(java21)" || return 1
  # Apalache writes its output under the directory it runs in:
  # https://apalache-mc.org/docs/apalache/running.html#4-detailed-output
  tmp="$(mktemp -d)"
  (cd "$tmp" && QUINT_HOME="$home" PATH="$bin:$PATH" "$dir/node_modules/.bin/quint" "$@")
  status=$?
  rm -rf "$tmp"
  return "$status"
}

check_fmt() {
  if $fix; then cargo fmt; else cargo fmt --check -- --color=never; fi
}

check_markdown() {
  if $fix; then
    rumdl check --fix .
  else
    rumdl check . 2>&1 | sed "s/^Run \`rumdl fmt\`/Run \`scripts\/check markdown\`/"
  fi
}

# Outside CI, builds assets/linewright.css from styles/linewright.css; in CI,
# fails when assets/linewright.css is not what styles/linewright.css builds.
check_css() {
  local built output status=0
  if $fix; then
    tailwind --input styles/linewright.css --output assets/linewright.css --minify
    return
  fi
  built="$(mktemp)"
  if ! output="$(tailwind --input styles/linewright.css --output "$built" --minify 2>&1)"; then
    echo "$output"
    status=1
  elif ! cmp -s "$built" assets/linewright.css; then
    echo "assets/linewright.css is not what styles/linewright.css builds: run \`scripts/check css\` and commit it"
    status=1
  fi
  rm -f "$built"
  return "$status"
}

# Fails when the deployment's compose files, alone and with the builds, break
# the compose specification, reading neither a host's `.env` nor its override.
check_compose() {
  compose -f deploy/compose.yaml config --quiet --no-env-resolution &&
    compose -f deploy/compose.yaml -f deploy/compose.build.yaml config \
      --quiet --no-env-resolution --no-interpolate
}

# Outside CI, first applies and formats clippy's machine-applicable
# suggestions. Fails on what clippy then reports.
check_clippy() {
  local args=(--all-targets --locked --quiet)
  if $fix; then
    # Under `deny`, cargo skips the crates that depend on one with warnings:
    # https://doc.rust-lang.org/cargo/reference/config.html#buildwarnings
    CARGO_BUILD_WARNINGS=allow cargo clippy --fix --allow-dirty --allow-staged \
      "${args[@]}" >/dev/null 2>&1 || true
    check_fmt
  fi
  cargo clippy "${args[@]}"
}
# Runs the tests, with the git binary that the `git` on the path runs. Fails
# on an override in .config/nextest.toml that matches no test, and on a test
# that is not `#[test_log::test]`, around `#[tokio::test]` where it is async,
# which outside CI it rewrites instead.
check_test() {
  local filter status=0 exec_path bare
  if exec_path="$(git --exec-path 2>/dev/null)" && [ -x "$exec_path/git" ]; then
    export PATH="$exec_path:$PATH"
  fi
  local attribute='^[ \t]*#\[(tokio::)?test(\(.*\))?\][ \t]*$'
  if bare="$(grep -rlE --include='*.rs' "$attribute" src tests)"; then
    if $fix; then
      # shellcheck disable=SC2086 # one path per line, none with spaces
      perl -pi -e 's/^([ \t]*)#\[test\][ \t]*$/$1#[test_log::test]/;
        s/^([ \t]*)#\[tokio::test(\(.*\))?\][ \t]*$/$1#[test_log::test(tokio::test$2)]/' $bare
    else
      # shellcheck disable=SC2016 # the backticks are Markdown's
      grep -rnE --include='*.rs' "$attribute" src tests |
        sed 's/$/: use `#[test_log::test]`, around `#[tokio::test]` where async/'
      status=1
    fi
  fi
  while IFS= read -r filter; do
    if [ -z "$(nextest list --locked --cargo-quiet --message-format oneline -E "$filter")" ]; then
      echo ".config/nextest.toml: the override filter $filter matches no test"
      status=1
    fi
  done < <(sed -n "s/^filter = '\(.*\)'$/\1/p" .config/nextest.toml)
  [ "$status" = 0 ] && nextest run --locked --cargo-quiet --no-input-handler
}
check_doc() { cargo doc --no-deps --locked --quiet; }

models="pipeline cut spec_change pull_request"
model_args=()

# Checks the definition `name` of the model in `file`, by its kind: a
# scenario (`run`) with `quint test`, a `temporal` property with TLC, and any
# other definition as an invariant with TLC. A row's witness
# (`rowNUnreached`) holds when TLC finds a state that violates it, where the
# row is the first that holds. S6_noFlap is checked from `initFlaps`.
check_property() {
  local file=$1 name=$2 args output
  if grep -qE "^\s*run $name\b" "$file"; then
    quint test --max-samples 100 --match "^$name\$" "$file"
    return
  elif grep -qE "^\s*temporal $name\b" docs/model/*.qnt; then
    args=(--temporal="$name")
  elif grep -qE "^\s*(pure )?val $name\b" docs/model/*.qnt; then
    args=(--invariant="$name")
  else
    echo "$(basename "$file"): no scenario, temporal property or invariant $name"
    return 1
  fi
  if [ "$name" = S6_noFlap ]; then
    args+=(--init=initFlaps)
  fi
  if [[ $name =~ ^row([0-9]+)Unreached$ ]]; then
    output="$(quint verify --backend=tlc "${args[@]}" "$file" 2>&1)"
    if ! grep -q '^\[violation\]' <<<"$output"; then
      echo "$output"
      echo "$(basename "$file"): no state where row ${BASH_REMATCH[1]} is the first that holds"
      return 1
    fi
    return
  fi
  quint verify --backend=tlc "${args[@]}" "$file"
}

# Every check of the model in `file`: its scenarios, then TLC over its
# invariants, S6's flaps and its temporal properties; for Working a pull
# request, a witness for each row instead of scenarios.
check_one_model() {
  local file=$1 status=0 row
  if [ "$(basename "$file")" = pull_request.qnt ]; then
    check_property "$file" invariants || status=1
    quint verify --backend=tlc --temporal=crashSafety,progress "$file" || status=1
    for row in $(seq 0 13); do
      check_property "$file" "row${row}Unreached" || status=1
    done
  else
    quint test --max-samples 100 "$file" || status=1
    check_property "$file" invariants || status=1
    check_property "$file" S6_noFlap || status=1
    quint verify --backend=tlc --temporal=S5_crashSafety,S6_progress "$file" || status=1
  fi
  return "$status"
}

# The checks of every model that take minutes, not hours: its scenarios, its
# invariants and, for Working a pull request, each row's witness. It leaves
# out S6's flaps and the temporal properties.
check_model-quick() {
  local name file status=0 row
  for name in $models; do
    file="$PWD/docs/model/$name.qnt"
    if [ "$name" = pull_request ]; then
      for row in $(seq 0 13); do
        check_property "$file" "row${row}Unreached" || status=1
      done
    else
      quint test --max-samples 100 "$file" || status=1
    fi
    check_property "$file" invariants || status=1
  done
  return "$status"
}

# Fails on a clause the model's comments quote that is not in the spec. A
# quote may elide with "...", and leave out the spec's parenthetical links and
# code. Whitespace and Markdown's emphasis, code and links are not compared.
check_model-quotes() {
  python3 -I - docs/model/*.qnt <<'EOF'
import glob, re, sys

def plain(s):
    s = re.sub(r" \((?:\[[^\]]*\]\([^)]*\)|`[^`]*`)[^()]*\)", "", s)
    s = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", s)
    return re.sub(r"\s+", " ", s.replace("`", "").replace("**", "").replace("_", " "))

spec_files = glob.glob("docs/specs/**/*.md", recursive=True) + ["GLOSSARY.md"]
spec = plain(" ".join(open(f).read() for f in spec_files))
comment = re.compile(r"\s*(?:///?|/\*\*|\*(?!/))\s?(.*)")
status = 0
for path in sys.argv[1:]:
    runs, run = [], []
    for number, line in enumerate(open(path), 1):
        m = comment.match(line)
        if m:
            run.append((number, m.group(1)))
        elif run:
            runs.append(run)
            run = []
    runs += [run] if run else []
    for run in runs:
        text, starts = "", []
        for number, line in run:
            starts.append((len(text), number))
            text += line + " "
        for m in re.finditer(r'"([^"]+)"', text):
            parts = [plain(p).strip() for p in re.split(r"\.\.\.|…", m.group(1))]
            if all(p in spec for p in parts if p):
                continue
            number = max(n for at, n in starts if at <= m.start())
            quote = re.sub(r"\s+", " ", m.group(1))
            print(f'{path}:{number}: "{quote}" is not in the spec')
            status = 1
sys.exit(status)
EOF
}

# Fails on every comment that is not one of the four kinds CODING_STANDARDS.md
# allows, in every tracked file but Markdown, the spec's model, vendored files
# and files without comments.
check_comments() {
  python3 -I scripts/check_comments.py
}

# Every model, or only the model and definitions named after `model`.
check_model() {
  local name status=0 file
  if [ ${#model_args[@]} -eq 0 ]; then
    for name in $models; do
      check_one_model "$PWD/docs/model/$name.qnt" || status=1
    done
    return "$status"
  fi
  file="$PWD/docs/model/${model_args[0]}.qnt"
  if [ ${#model_args[@]} -eq 1 ]; then
    check_one_model "$file"
    return
  fi
  for name in "${model_args[@]:1}"; do
    check_property "$file" "$name" || status=1
  done
  return "$status"
}

stages=("fmt markdown compose css comments" "clippy" "test doc")
named_only="model-quotes model-quick model"

usage() {
  echo "usage: scripts/check [NAME...]"
  echo "       scripts/check model MODEL [DEFINITION...]"
  echo "Runs every check CI runs, or only the named ones: ${stages[*]} $named_only."
  echo "Without names it leaves out: $named_only."
  echo "Outside CI it first fixes what it can: formatting, Markdown and clippy's"
  echo "machine-applicable suggestions, and it rebuilds the web UI's stylesheet."
  echo "With a model ($models),"
  echo "it checks only that model, or only its named scenarios, invariants and"
  echo "temporal properties."
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  usage
  exit 0
fi
if [ "${1:-}" = model ] && [ $# -gt 1 ]; then
  if [[ " $models " != *" $2 "* ]]; then
    echo "scripts/check model: no model $2; the models are: $models" >&2
    exit 2
  fi
  shift
  model_args=("$@")
  set -- model
fi
if [ $# -gt 0 ]; then
  for name in "$@"; do
    if ! declare -F "check_$name" >/dev/null; then
      usage >&2
      exit 2
    fi
  done
  stages=("$*")
fi

passed=""
failed=""
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
for i in "${!stages[@]}"; do
  for name in ${stages[$i]}; do
    if [ "$name" = test ]; then
      if check_test; then
        passed="$passed $name"
      else
        printf '✗ %s\n' "$name"
        failed="$failed $name"
      fi
    elif "check_$name" >"$log" 2>&1; then
      passed="$passed $name"
    else
      printf '✗ %s\n' "$name"
      cat "$log"
      failed="$failed $name"
    fi
  done
  if [ -n "$failed" ]; then
    skipped="${stages[*]:$((i + 1))}"
    echo "failed:$failed${skipped:+; not run: $skipped}"
    exit 1
  fi
done
echo "ok:$passed (${SECONDS}s)"
