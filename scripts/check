#!/usr/bin/env bash
set -euo pipefail
invoked_in="$PWD"
cd "$(dirname "$0")/.."
# shellcheck source=scripts/lib.sh
. scripts/lib.sh

check_fmt() {
  cargo fmt --check -- --color=never || {
    echo "Run \`scripts/fix fmt\`"
    return 1
  }
}

check_markdown() {
  rumdl check . 2>&1 | sed "s/^Run \`rumdl fmt\`/Run \`scripts\/fix markdown\`/"
}

# Fails when assets/linewright.css is not what styles/linewright.css builds.
check_css() {
  local built output status=0
  built="$(mktemp)"
  if ! output="$(tailwind --input styles/linewright.css --output "$built" --minify 2>&1)"; then
    echo "$output"
    status=1
  elif ! cmp -s "$built" assets/linewright.css; then
    echo "assets/linewright.css is not what styles/linewright.css builds: run \`scripts/fix css\` and commit it"
    status=1
  fi
  rm -f "$built"
  return "$status"
}

# Fails when the deployment's compose files, alone and with the builds, break
# the compose specification, reading neither a host's `.env` nor its override.
check_compose() {
  compose -f deploy/compose.yaml config --quiet --no-env-resolution &&
    compose -f deploy/compose.yaml -f deploy/compose.build.yaml config \
      --quiet --no-env-resolution --no-interpolate
}

# Fails on what clippy reports.
check_clippy() {
  cargo clippy --all-targets --locked --quiet || {
    echo "Run \`scripts/fix clippy\` for the machine-applicable suggestions"
    return 1
  }
}

# Runs the tests, with the git binary that the `git` on the path runs. Fails
# on an override in .config/nextest.toml that matches no test, and on a test
# that is not `#[test_log::test]`, around `#[tokio::test]` where it is async.
check_test() {
  local filter status=0 exec_path
  if exec_path="$(git --exec-path 2>/dev/null)" && [ -x "$exec_path/git" ]; then
    export PATH="$exec_path:$PATH"
  fi
  if grep -rqE --include='*.rs' "$test_attribute" src tests; then
    # shellcheck disable=SC2016 # the backticks are Markdown's
    grep -rnE --include='*.rs' "$test_attribute" src tests |
      sed 's/$/: use `#[test_log::test]`, around `#[tokio::test]` where async: run `scripts\/fix test`/'
    status=1
  fi
  while IFS= read -r filter; do
    if [ -z "$(nextest list --locked --cargo-quiet --message-format oneline -E "$filter")" ]; then
      echo ".config/nextest.toml: the override filter $filter matches no test"
      status=1
    fi
  done < <(sed -n "s/^filter = '\(.*\)'$/\1/p" .config/nextest.toml)
  [ "$status" = 0 ] && nextest run --locked --cargo-quiet --no-input-handler
}
check_doc() { cargo doc --no-deps --locked --quiet; }

models="pipeline cut spec_change pull_request"
model_args=()

# Checks the definition `name` of the model in `file`, by its kind: a
# scenario (`run`) with `quint test`, a `temporal` property with TLC, and any
# other definition as an invariant with TLC. A row's witness
# (`rowNUnreached`) holds when TLC finds a state that violates it, where the
# row is the first that holds. S6_noFlap is checked from `initFlaps`.
check_property() {
  local file=$1 name=$2 args output
  if grep -qE "^\s*run $name\b" "$file"; then
    quint test --max-samples 100 --match "^$name\$" "$file"
    return
  elif grep -qE "^\s*temporal $name\b" quint/*.qnt; then
    args=(--temporal="$name")
  elif grep -qE "^\s*(pure )?val $name\b" quint/*.qnt; then
    args=(--invariant="$name")
  else
    echo "$(basename "$file"): no scenario, temporal property or invariant $name"
    return 1
  fi
  if [ "$name" = S6_noFlap ]; then
    args+=(--init=initFlaps)
  fi
  if [[ $name =~ ^row([0-9]+)Unreached$ ]]; then
    output="$(quint verify --backend=tlc "${args[@]}" "$file" 2>&1)"
    if ! grep -q '^\[violation\]' <<<"$output"; then
      echo "$output"
      echo "$(basename "$file"): no state where row ${BASH_REMATCH[1]} is the first that holds"
      return 1
    fi
    return
  fi
  quint verify --backend=tlc "${args[@]}" "$file"
}

# Every check of the model in `file`: its scenarios, then TLC over its
# invariants, S6's flaps and its temporal properties; for Working a pull
# request, a witness for each row instead of scenarios.
check_one_model() {
  local file=$1 status=0 row
  if [ "$(basename "$file")" = pull_request.qnt ]; then
    check_property "$file" invariants || status=1
    quint verify --backend=tlc --temporal=crashSafety,progress "$file" || status=1
    for row in $(seq 0 14); do
      check_property "$file" "row${row}Unreached" || status=1
    done
  else
    quint test --max-samples 100 "$file" || status=1
    check_property "$file" invariants || status=1
    check_property "$file" S6_noFlap || status=1
    quint verify --backend=tlc --temporal=S5_crashSafety,S6_progress "$file" || status=1
  fi
  return "$status"
}

# The checks of every model short of S6's flaps and the temporal properties:
# its scenarios, its invariants and, for Working a pull request, each row's
# witness.
check_model-quick() {
  local name file status=0 row
  for name in $models; do
    file="$PWD/quint/$name.qnt"
    if [ "$name" = pull_request ]; then
      for row in $(seq 0 14); do
        check_property "$file" "row${row}Unreached" || status=1
      done
    else
      quint test --max-samples 100 "$file" || status=1
    fi
    check_property "$file" invariants || status=1
  done
  return "$status"
}

# Fails where what a spec-table directive in the model generates is not what
# the spec's table reads now, on a `when_`, `does_` or `result_` definition a
# table needs and the model lacks, and on one no table needs
# (`scripts/model_tables.py` describes the directives).
check_model-tables() {
  python3 -I -B scripts/model_tables.py --check
}

# Fails on a clause the model's comments quote that is not in the spec. A
# quote may elide with "...", and leave out the spec's parenthetical links and
# code. Whitespace and Markdown's emphasis, code and links are not compared.
check_model-quotes() {
  python3 -I -B scripts/check_model.py quotes
}

# Fails on a sentence of a section the model says it encodes in full that the
# model does not quote, and on a table in one without a spec-table directive.
check_model-coverage() {
  python3 -I -B scripts/check_model.py coverage
}

# Fails on every comment that is not one of the four kinds CODING_STANDARDS.md
# allows, in every tracked file but Markdown, the spec's model, vendored files
# and files without comments.
check_comments() {
  python3 -I scripts/check_comments.py
}

# Every model, or only the model and definitions named after `model`.
check_model() {
  local name status=0 file
  if [ ${#model_args[@]} -eq 0 ]; then
    for name in $models; do
      check_one_model "$PWD/quint/$name.qnt" || status=1
    done
    return "$status"
  fi
  file="$PWD/quint/${model_args[0]}.qnt"
  if [ ${#model_args[@]} -eq 1 ]; then
    check_one_model "$file"
    return
  fi
  for name in "${model_args[@]:1}"; do
    check_property "$file" "$name" || status=1
  done
  return "$status"
}

# Runs the way `way` to `operation` (copy or remove) the tree `tree` once,
# leaving its log in `log`: fails where the way fails or, for a copy, makes a
# copy that is not faithful.
bench_way_works() {
  local operation=$1 way=$2 tree=$3 status=0
  if [ "$operation" = copy ]; then
    tree-bench copy "$way" "$tree" copy >log 2>&1 && tree-bench same "$tree" copy >>log 2>&1 || status=1
  else
    tree-bench copy linewright "$tree" clone >log 2>&1 && tree-bench remove "$way" clone >>log 2>&1 || status=1
  fi
  tree-bench remove linewright copy && tree-bench remove linewright clone && return "$status"
}

# Fails where Linewright copies a tree, or removes one, in more than 1.2
# times the fastest known way that works on the filesystem of BENCH_DIR
# (default TMPDIR), timed by hyperfine on BENCH_TREE, a directory on that
# filesystem relative to where the script runs, or else on a tree shaped
# like an environment (`docs/specs/runs.md`, Performance). A way that fails,
# or makes a copy that is not faithful, is named and left out.
check_bench() {
  (
    local work tree quoted_tree operation way ways status=0
    if ! command -v hyperfine >/dev/null; then
      echo "bench needs hyperfine: https://github.com/sharkdp/hyperfine#installation"
      return 1
    fi
    if [ -n "${BENCH_TREE:-}" ]; then
      tree="$(cd "$invoked_in" && cd "$BENCH_TREE" && pwd)" || return 1
    fi
    cargo build --release --locked --quiet --features bench --bin tree-bench || return 1
    export PATH="$PWD/target/release:$PATH"
    work="$(mktemp -d "${BENCH_DIR:-${TMPDIR:-/tmp}}/tree-bench.XXXXXX")"
    trap 'tree-bench remove linewright "$work"' EXIT
    cd "$work"
    if [ -z "${tree:-}" ]; then
      tree=tree
      echo "Generating the tree in $work/tree"
      tree-bench tree tree || return 1
    fi
    quoted_tree="$(printf %q "$tree")"
    for operation in copy remove; do
      ways=()
      for way in $(tree-bench ways "$operation"); do
        if bench_way_works "$operation" "$way" "$tree"; then
          if [ "$operation" = copy ]; then
            ways+=("tree-bench copy $way $quoted_tree copy")
          else
            ways+=("tree-bench remove $way clone")
          fi
        elif [ "$way" = linewright ]; then
          echo "$operation: Linewright's way does not work:"
          cat log
          return 1
        else
          echo "$operation: $way does not work, so it is left out:"
          head -n 5 log
        fi
      done
      if [ "$operation" = copy ]; then
        hyperfine --runs 5 --export-json copy.json \
          --prepare "tree-bench remove linewright copy" \
          --cleanup "tree-bench remove linewright copy" \
          --reference "${ways[0]}" "${ways[@]:1}" || return 1
      else
        hyperfine --warmup 3 --runs 5 --export-json remove.json \
          --prepare "tree-bench remove linewright clone && tree-bench copy linewright $quoted_tree clone" \
          --reference "${ways[0]}" "${ways[@]:1}" || return 1
      fi
    done
    tree-bench verdict copy copy.json || status=1
    tree-bench verdict remove remove.json || status=1
    return "$status"
  )
}

stages=("fmt markdown compose css comments model-tables model-quotes model-coverage" "clippy" "test doc")
named_only="model-quick model bench"

usage() {
  echo "usage: scripts/check [NAME...]"
  echo "       scripts/check model MODEL [DEFINITION...]"
  echo "Runs every check CI runs, or only the named ones: ${stages[*]} $named_only."
  echo "Without names it leaves out: $named_only."
  echo "It changes nothing: scripts/fix applies the fixes the checks name."
  echo "With a model ($models),"
  echo "it checks only that model, or only its named scenarios, invariants and"
  echo "temporal properties."
  echo "bench times Linewright's copy and removal of a tree against the known ways,"
  echo "on the filesystem of BENCH_DIR (default TMPDIR), on the tree BENCH_TREE or a"
  echo "generated one. It needs hyperfine and takes minutes."
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  usage
  exit 0
fi
if [ "${1:-}" = model ] && [ $# -gt 1 ]; then
  if [[ " $models " != *" $2 "* ]]; then
    echo "scripts/check model: no model $2; the models are: $models" >&2
    exit 2
  fi
  shift
  model_args=("$@")
  set -- model
fi
if [ $# -gt 0 ]; then
  for name in "$@"; do
    if ! declare -F "check_$name" >/dev/null; then
      usage >&2
      exit 2
    fi
  done
  stages=("$*")
fi

passed=""
failed=""
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
for i in "${!stages[@]}"; do
  for name in ${stages[$i]}; do
    if [ "$name" = test ] || [ "$name" = bench ]; then
      if "check_$name"; then
        passed="$passed $name"
      else
        printf '✗ %s\n' "$name"
        failed="$failed $name"
      fi
    elif "check_$name" >"$log" 2>&1; then
      passed="$passed $name"
    else
      printf '✗ %s\n' "$name"
      cat "$log"
      failed="$failed $name"
    fi
  done
  if [ -n "$failed" ]; then
    skipped="${stages[*]:$((i + 1))}"
    echo "failed:$failed${skipped:+; not run: $skipped}"
    exit 1
  fi
done
echo "ok:$passed (${SECONDS}s)"
