#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# https://doc.rust-lang.org/cargo/reference/config.html#buildwarnings
export CARGO_BUILD_WARNINGS=deny

case "${CI:-}" in
true | 1) fix=false ;;
*) fix=true ;;
esac

# The tools below are fetched from their releases and checked against these
# hashes, so this is the one place their versions are set: rumdl
# (https://github.com/rvben/rumdl), Docker Compose
# (https://github.com/docker/compose), which validates a compose file without
# a Docker daemon, and cargo-nextest (https://nexte.st), which names and kills
# a hung test, and Tailwind's standalone CLI
# (https://tailwindcss.com/docs/installation/tailwind-cli), which builds the
# web UI's stylesheet.
rumdl_version=0.2.79
compose_version=5.6.0
nextest_version=0.9.148
tailwind_version=4.3.3

has_sha256() {
  local actual
  actual="$({ sha256sum "$1" 2>/dev/null || shasum -a 256 "$1"; } | cut -d' ' -f1)"
  if [ "$actual" != "$2" ]; then
    echo "$1 has sha256 $actual, not $2"
    return 1
  fi
}

# Installs the download at `url`, if it has sha256 `sha`, as `dir/name`: the
# file `member` in it when it is a tar.gz, or the download itself.
install_tool() {
  local dir=$1 name=$2 url=$3 sha=$4 member=${5:-} tmp
  tmp="$(mktemp -d)"
  # Renamed into place, so a check running at the same time never sees half
  # a binary.
  if curl -fsSL -o "$tmp/download" "$url" &&
    has_sha256 "$tmp/download" "$sha" &&
    if [ -n "$member" ]; then
      tar -xzf "$tmp/download" -C "$tmp" && mv "$tmp/$member" "$tmp/download"
    fi &&
    chmod +x "$tmp/download" &&
    mkdir -p "$dir" &&
    mv "$tmp/download" "$dir/$name.$$" &&
    mv -f "$dir/$name.$$" "$dir/$name"; then
    rm -rf "$tmp"
  else
    rm -rf "$tmp"
    return 1
  fi
}

no_release() {
  echo "$1 has no release for $(uname -sm)"
  return 1
}

rumdl() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/linewright/rumdl-$rumdl_version" target sha archive
  if [ ! -x "$dir/rumdl" ]; then
    case "$(uname -sm)" in
    "Darwin arm64") target=aarch64-apple-darwin sha=8c0ecf93a61bf612df5f6c6f22813d066a6f51a5680f3c12da49b93ed892aebb ;;
    "Darwin x86_64") target=x86_64-apple-darwin sha=09cca63968f9a3f35faab71ac8d09bda1a96ba4e0e38cac54bfb7b544523075f ;;
    "Linux aarch64" | "Linux arm64") target=aarch64-unknown-linux-musl sha=f2ccb236a6b62b9980711a2f54c1e0d8d91ceaea5d7313d0b1a615237b3130bf ;;
    "Linux x86_64") target=x86_64-unknown-linux-musl sha=a85ae77c6880616118e10dda1e36292df59815bcfbf767201736ff6971213cf3 ;;
    *) no_release "rumdl $rumdl_version" || return 1 ;;
    esac
    archive="rumdl-v$rumdl_version-$target.tar.gz"
    install_tool "$dir" rumdl \
      "https://github.com/rvben/rumdl/releases/download/v$rumdl_version/$archive" \
      "$sha" rumdl || return 1
  fi
  "$dir/rumdl" "$@"
}

compose() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/linewright/compose-$compose_version" target sha
  if [ ! -x "$dir/docker-compose" ]; then
    case "$(uname -sm)" in
    "Darwin arm64") target=darwin-aarch64 sha=bd714a42b46e51757fc1121085b3096b9064e3f80d3ca5a991e33f44df4f43c9 ;;
    "Darwin x86_64") target=darwin-x86_64 sha=c76e3abf5fde1aeb3bd7c7306ff15bef2246afc1f9e54832a0a050dd7cdfb2f8 ;;
    "Linux aarch64" | "Linux arm64") target=linux-aarch64 sha=733ec76717ceb59052a9609b9dadfb523b2df8eab57a54212872d10a58078ea2 ;;
    "Linux x86_64") target=linux-x86_64 sha=40343e21ca777173e69cff5dbafeb37c6f81f3b0d57d9e597f036e95eb63e76a ;;
    *) no_release "Docker Compose $compose_version" || return 1 ;;
    esac
    install_tool "$dir" docker-compose \
      "https://github.com/docker/compose/releases/download/v$compose_version/docker-compose-$target" \
      "$sha" || return 1
  fi
  "$dir/docker-compose" "$@"
}

nextest() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/linewright/nextest-$nextest_version" target sha archive
  if [ ! -x "$dir/cargo-nextest" ]; then
    case "$(uname -sm)" in
    "Darwin arm64" | "Darwin x86_64") target=universal-apple-darwin sha=6c23b7fb4ca82c571fc8dfedbab45bfa773d45918f933170c85d21cd7f4b852b ;;
    "Linux aarch64" | "Linux arm64") target=aarch64-unknown-linux-musl sha=94676506ceaed01746d78cfe9ed124ee841b2932fd18d9d10f438a347bd9ba5e ;;
    "Linux x86_64") target=x86_64-unknown-linux-musl sha=bf92cb81450872d960ffa13857a83084d557ec0cdc141663d263bb23ef756f97 ;;
    *) no_release "cargo-nextest $nextest_version" || return 1 ;;
    esac
    archive="cargo-nextest-$nextest_version-$target.tar.gz"
    install_tool "$dir" cargo-nextest \
      "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-$nextest_version/$archive" \
      "$sha" cargo-nextest || return 1
  fi
  "$dir/cargo-nextest" nextest "$@"
}

tailwind() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/linewright/tailwind-$tailwind_version" target sha
  if [ ! -x "$dir/tailwindcss" ]; then
    case "$(uname -sm)" in
    "Darwin arm64") target=macos-arm64 sha=cdf646702987a743464dff4d9c60fd4480d1c1e73dd819a9a67f1078815dce9d ;;
    "Darwin x86_64") target=macos-x64 sha=7922e0953f2110c05976e3bf58f14e643d90427575e766b7d433f5f80cbee7e1 ;;
    "Linux aarch64" | "Linux arm64") target=linux-arm64 sha=55fd0b241214eff3de1e8ee4f22796662f2d2e7a49bcfca7477cfd0bac398195 ;;
    "Linux x86_64") target=linux-x64 sha=dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a ;;
    *) no_release "Tailwind CSS $tailwind_version" || return 1 ;;
    esac
    install_tool "$dir" tailwindcss \
      "https://github.com/tailwindlabs/tailwindcss/releases/download/v$tailwind_version/tailwindcss-$target" \
      "$sha" || return 1
  fi
  "$dir/tailwindcss" "$@"
}

check_fmt() {
  if $fix; then cargo fmt; else cargo fmt --check -- --color=never; fi
}

check_markdown() {
  if $fix; then
    rumdl check --fix .
  else
    # rumdl itself is not on the PATH.
    rumdl check . 2>&1 | sed "s/^Run \`rumdl fmt\`/Run \`scripts\/check markdown\`/"
  fi
}

# The web UI's stylesheet, built from styles/linewright.css with daisyUI, is
# committed, so that a cargo build needs no other toolchain. Outside CI it is
# rebuilt; in CI it fails when the committed one is not what the sources
# build.
check_css() {
  local built output status=0
  if $fix; then
    tailwind --input styles/linewright.css --output assets/linewright.css --minify
    return
  fi
  built="$(mktemp)"
  # Tailwind reports on success too, so its output is shown only when it
  # fails.
  if ! output="$(tailwind --input styles/linewright.css --output "$built" --minify 2>&1)"; then
    echo "$output"
    status=1
  elif ! cmp -s "$built" assets/linewright.css; then
    echo "assets/linewright.css is not what styles/linewright.css builds: run \`scripts/check css\` and commit it"
    status=1
  fi
  rm -f "$built"
  return "$status"
}

# The deployment's compose files against the compose specification: their
# keys, types and references between services, networks and volumes, alone
# as a host runs them and with the builds CI runs. Its `.env` and override
# are the host's, so neither is read, and the commit CI builds from is not
# set, so the build file is not interpolated.
check_compose() {
  compose -f deploy/compose.yaml config --quiet --no-env-resolution &&
    compose -f deploy/compose.yaml -f deploy/compose.build.yaml config \
      --quiet --no-env-resolution --no-interpolate
}

# Outside CI, clippy's machine-applicable suggestions are applied and
# formatted first, with warnings allowed, since under `deny` cargo would skip
# the crates that depend on one with warnings left
# (https://doc.rust-lang.org/cargo/reference/config.html#buildwarnings), and
# their warnings would go unfixed. Then the check runs as in CI and reports,
# and fails on, what is left. The fix pass's own output and status are
# dropped, since the check repeats any error or warning in it.
check_clippy() {
  local args=(--all-targets --locked --quiet)
  if $fix; then
    CARGO_BUILD_WARNINGS=allow cargo clippy --fix --allow-dirty --allow-staged \
      "${args[@]}" >/dev/null 2>&1 || true
    check_fmt
  fi
  cargo clippy "${args[@]}"
}
check_test() { nextest run --locked --cargo-quiet --no-input-handler; }
check_doc() { cargo doc --no-deps --locked --quiet; }

stages=("fmt markdown compose css" "clippy" "test doc")

usage() {
  echo "usage: scripts/check [NAME...]"
  echo "Runs every check CI runs, or only the named ones: ${stages[*]}."
  echo "Outside CI it first fixes what it can: formatting, Markdown and clippy's"
  echo "machine-applicable suggestions, and it rebuilds the web UI's stylesheet."
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  usage
  exit 0
fi
if [ $# -gt 0 ]; then
  for name in "$@"; do
    if ! declare -F "check_$name" >/dev/null; then
      usage >&2
      exit 2
    fi
  done
  stages=("$*")
fi

passed=""
failed=""
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
for i in "${!stages[@]}"; do
  for name in ${stages[$i]}; do
    # The tests print only what failed, was slow or hung, and as it happens,
    # so a hang still names its test.
    if [ "$name" = test ]; then
      if check_test; then
        passed="$passed $name"
      else
        printf '✗ %s\n' "$name"
        failed="$failed $name"
      fi
    elif "check_$name" >"$log" 2>&1; then
      passed="$passed $name"
    else
      printf '✗ %s\n' "$name"
      cat "$log"
      failed="$failed $name"
    fi
  done
  if [ -n "$failed" ]; then
    skipped="${stages[*]:$((i + 1))}"
    echo "failed:$failed${skipped:+; not run: $skipped}"
    exit 1
  fi
done
echo "ok:$passed (${SECONDS}s)"
